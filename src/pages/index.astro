---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/Base.astro";

const allPosts = await getCollection("blog");
const title = "Home";
---

<PageLayout title={title}>
    <section class="hero">
        <p>
            Welkom op mijn persoonlijke blog en schrijfruimte. Hier hou ik
            gedachten en notities bij over over wat mij zo al bezig houdt;
            voornamelijk een mix van code, infra, cloud-native en wat op dat
            moment mijn interesse heeft.
        </p>
    </section>
    <section class="writing">
        <h2>Blog</h2>
        <ul>
            {
                allPosts.map((post) => (
                    <li class="test">
                        <time datetime={post.data.pubDate.toISOString()}>
                            {post.data.pubDate.toLocaleDateString("nl-NL", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric",
                            })}
                        </time>
                        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </li>
                ))
            }
        </ul>
    </section>
</PageLayout>

<style>
    .hero {
        margin-bottom: 2rem;
    }

    h2 {
        margin-top: 2rem;
    }

    .writing {
        border-top: 1px solid var(--color-border);
    }

    .writing ul {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }

    .writing a {
        margin-left: 1rem;
    }
</style>
